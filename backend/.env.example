# VoiceKhata Environment Variables

# Server
PORT=3000

# Database
# If running locally via Docker
DATABASE_URL=postgres://postgres:password@localhost:5432/voicekhata

# Redis (BullMQ Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# AI APIs
# Get this from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get this from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Get this from https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# WhatsApp Webhook
WHATSAPP_VERIFY_TOKEN=voicekhata_secure_token_123
