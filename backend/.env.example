# Copy to backend/.env for local development. NEVER commit the real .env.
# The server refuses to start if a required value is missing or too weak.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:password@localhost:5432/voicekhata
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Dashboard login. Preferred: a bcrypt hash from `npm run hash-password -- "your password"`
DASHBOARD_PASSWORD_HASH=
# ...or a plain password of at least 10 characters (less safe)
# DASHBOARD_PASSWORD=

# --- Twilio (WhatsApp) -------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+14155238886
# The public URL Twilio calls. Twilio signs requests against it, so it must match
# the webhook URL configured in Twilio exactly (without /webhook/whatsapp).
# On Render this falls back to RENDER_EXTERNAL_URL automatically.
PUBLIC_BASE_URL=https://your-app.onrender.com
# Only for local testing with hand-made requests. Keep "true" in production.
TWILIO_VALIDATE_SIGNATURE=true

# --- AI ----------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GROQ_API_KEY=
# Money-changing entries below this confidence are rejected with "please repeat"
AI_MIN_CONFIDENCE=0.6
# Warn in the WhatsApp summary if the spoken rate differs from the price list by more than this %
PRICE_VARIANCE_WARN_PCT=10

# --- Queue -------------------------------------------------------------------
# Upstash / Render Redis URL, or leave empty to use REDIS_HOST/REDIS_PORT (docker-compose uses 6380)
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# --- Other -------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Comma-separated dashboard origins allowed to call the API
CORS_ORIGINS=http://localhost:3001,https://voice-khata.vercel.app
# Tests use ONLY this (never DATABASE_URL). The database name must contain "test".
TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/voicekhata_test
